    "@tanstack/react-query": "5.62.11",
    "@unocss/reset": "0.65.3",
    "add": "2.0.6",
    "isbot": "5.1.19",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "use-dehydrated-state": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@remix-run/dev": "2.15.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@unocss/cli": "0.65.3",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "typescript": "5.7.2",
    "unocss": "0.65.3",
    "vite": "5.4.11",
    "vite-tsconfig-paths": "4.3.2"
