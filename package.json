{
  "name": "plantica",
  "description": "",
  "license": "",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "concurrently 'bun run css --watch' 'remix vite:dev'",
    "build": "bun run css && remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "css": "unocss 'app/**/*.tsx' --out-file=app/styles/uno.css",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "ncu": "bunx npm-check-updates"
  },
  "dependencies": {
    "@remix-run/node": "2.16.5",
    "@remix-run/react": "2.16.5",
    "@remix-run/serve": "2.16.5",
    "@tanstack/react-query": "5.74.9",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@unocss/reset": "0.65.4",
    "date-fns": "4.1.0",
    "isbot": "5.1.27",
    "jotai": "2.12.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tiny-invariant": "1.3.3",
    "use-dehydrated-state": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@remix-run/dev": "2.16.5",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.3",
    "@unocss/cli": "0.65.4",
