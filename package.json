{
  "name": "plantica",
  "description": "",
  "license": "",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "concurrently 'bun run css --watch' 'remix vite:dev'",
    "build": "bun run css && remix vite:build",
    "start": "remix-serve ./build/server/index.js",
    "css": "unocss 'app/**/*.tsx' --out-file=app/styles/uno.css",
    "check": "biome check",
    "check:fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "ncu": "bunx npm-check-updates"
  },
  "dependencies": {
    "@remix-run/node": "2.15.2",
    "@remix-run/react": "2.15.2",
    "@remix-run/serve": "2.15.2",
    "@tanstack/react-query": "5.62.15",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@unocss/reset": "0.65.3",
    "date-fns": "4.1.0",
    "isbot": "5.1.20",
    "jotai": "2.11.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tiny-invariant": "1.3.3",
    "use-dehydrated-state": "0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@remix-run/dev": "2.15.2",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@unocss/cli": "0.65.3",
    "@vitejs/plugin-react-swc": "3.7.2",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.2",
    "happy-dom": "16.3.0",
    "typescript": "5.7.2",
    "unocss": "0.65.3",
    "vite": "5.4.11",
    "vite-tsconfig-paths": "4.3.2",
    "vitest": "2.1.8"
  }
